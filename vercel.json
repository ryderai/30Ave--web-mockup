{
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/directory/hill-coleman",
      "destination": "/directory/annie-mac-home-mortgage/",
      "permanent": true
    },
    {
      "source": "/merchant-map",
      "destination": "/map/",
      "permanent": true
    },
    {
      "source": "/directory/bohlert-massey",
      "destination": "/directory/bohlert-massey-interiors-shop/",
      "permanent": true
    },
    {
      "source": "/directory/lighting-etc",
      "destination": "/directory/lighting-etc-shop/",
      "permanent": true
    },
    {
      "source": "/directory/myst-shop",
      "destination": "/directory/myst/",
      "permanent": true
    },
    {
      "source": "/directory/not-too-shabby",
      "destination": "/directory/not-too-shabby-store/",
      "permanent": true
    },
    {
      "source": "/directory/rollands-beauty-bar-shop",
      "destination": "/directory/rollands-beauty-bar/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}